<?xml version="1.0" encoding="utf-8"?>
<!-- Корпус виджета: тот же рубленый прямоугольник с бордером в 2dp, что
     у PixelCard в приложении. Ни elevation, ни размытых теней — они
     здесь читались бы как Material поверх пиксельной графики. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke
        android:width="2dp"
        android:color="@color/widget_border" />
    <corners android:radius="8dp" />
</shape>
