<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема запуска: чёрный фон системного сплэша, чтобы не было белой
         вспышки перед тёмным интерфейсом. Саму анимацию логотипа рисует
         Compose — системный сплэш держим на минимуме, запуск важнее эффекта. -->
    <style name="Theme.W0y.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/w0y_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.W0y</item>
    </style>

    <style name="Theme.W0y" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/w0y_bg</item>
    </style>
</resources>
